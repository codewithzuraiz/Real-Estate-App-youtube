rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Properties: Allow anyone to view listings, authenticated users can create/update/delete
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Users collection:
    match /users/{userId} {
      // Allow user to read/write their own profile
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // User favorites sub-collection:
      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default rule for other collections (e.g. while testing/developing):
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
